generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== TENANT / BUSINESS (PLAN.md §7) ====================
// New in Phase 1 (§46.1). Not yet read/written by any application route —
// that cutover is Phase 2+. Populated by scripts/phase1-tenant-migration.ts.

model Business {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  status    String   @default("active") // active, suspended, deleted
  planId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  config             BusinessConfig?
  channelConnections ChannelConnection[]
  apiKeys            ApiKey[]
  placement          TenantPlacement?

  // Every tenant-owned model gains a businessId relation back to Business
  // (§7.1, §12), contracted in the same migration that makes each model's
  // businessId required.
  categories        Category[]
  knowledgeEntries  KnowledgeEntry[]
  departments       Department[]
  teamMembers       TeamMember[]
  customers         Customer[]
  customerNotes     CustomerNote[]
  conversations     Conversation[]
  messages          Message[]
  tickets           Ticket[]
  tags              Tag[]
  conversationTags  ConversationTag[]
  internalNotes     InternalNote[]
  callLogs          CallLog[]
  schedules         Schedule[]
  webhooks          Webhook[]
  webhookDeliveries WebhookDelivery[]
  activityLogs      ActivityLog[]
  slaRules          SLARule[]
  cannedResponses   CannedResponse[]
  automationRules   AutomationRule[]
  campaigns         Campaign[]
  flows             Flow[]
  businessHours     BusinessHours[]
}

model Membership {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String // owner | admin | supervisor | agent | viewer (§9)
  createdAt  DateTime @default(now())

  @@unique([businessId, userId])
  @@index([userId])
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  password        String
  name            String   @default("")
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships Membership[]
}

// ==================== CONTROL PLANE (PLAN.md §7.4-7.6) ====================
// Read by platform infrastructure to route a request/job to the right tenant
// data connection. Not tenant-owned data; a tenant admin never edits these
// directly. Until Phase 9 every business resolves to "shared-default", which
// points at the same connection the app already uses.

model TenantPlacement {
  businessId        String   @id
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  databaseProfileId String   @default("shared-default")
  storageProfileId  String   @default("shared-default")
  updatedAt         DateTime @updatedAt
}

model DatabaseProfile {
  id                  String   @id // e.g. "shared-default", "dedicated-eu-42"
  connectionSecretRef String // opaque reference into the SecretResolver boundary (§10.3) — never the DSN itself
  region              String   @default("us")
  createdAt           DateTime @default(now())
}

model StorageProfile {
  id                  String   @id
  credentialSecretRef String
  bucket              String
  region              String   @default("us")
  createdAt           DateTime @default(now())
}

// ==================== BUSINESS CONFIG (PLAN.md §10.2) ====================
// Successor to Settings' non-secret fields. One row per Business. AI
// provider/model/embedding/token/temperature fields are nullable = "inherit
// platform default" (§10.2); everything else mirrors Settings' own defaults.

model BusinessConfig {
  businessId        String   @id
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessName      String   @default("My Business")
  businessDesc      String   @default("")
  welcomeMessage    String   @default("Hello! How can I help you today?")
  tone              String   @default("friendly")
  language          String   @default("auto")
  aiProvider        String?
  aiModel           String?
  embeddingProvider String?
  maxTokens         Int?
  temperature       Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==================== CHANNEL CONNECTION (PLAN.md §7.7) ====================
// Replaces the one-row-per-type Channel model: a business has zero-to-many
// connections per channel type. Secrets are never stored here directly —
// `credentialRef` is an opaque SecretResolver reference (§10.3).

model ChannelConnection {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type          String // "whatsapp", "email", "sms", "telegram", "phone", "webchat"
  name          String
  isActive      Boolean  @default(false)
  isDefault     Boolean  @default(false)
  status        String   @default("disconnected")
  config        Json     @default("{}")
  credentialRef String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, id])
  @@index([businessId, type])
}

// ==================== SETTINGS ====================
// Retained, unused by new code, for one release per PLAN.md §13.2 step 7 —
// superseded by BusinessConfig + ChannelConnection above.

model Settings {
  id               String   @id @default("default")
  businessName     String   @default("My Business")
  businessDesc     String   @default("")
  welcomeMessage   String   @default("Hello! How can I help you today?")
  tone             String   @default("friendly")
  language         String   @default("auto")
  aiProvider       String   @default("openai")
  aiModel          String   @default("gpt-4o-mini")
  aiApiKey         String   @default("")
  maxTokens        Int      @default(2048)
  temperature      Float    @default(0.7)
  elevenLabsKey    String   @default("")
  elevenLabsVoice  String   @default("")
  twilioSid        String   @default("")
  twilioToken      String   @default("")
  twilioPhone      String   @default("")
  smtpHost         String   @default("")
  smtpPort         Int      @default(587)
  smtpUser         String   @default("")
  smtpPass         String   @default("")
  smtpFrom         String   @default("")
  imapHost         String   @default("")
  imapPort         Int      @default(993)
  imapUser         String   @default("")
  imapPass         String   @default("")
  whatsappMode     String   @default("web")
  whatsappApiKey   String   @default("")
  whatsappPhone    String   @default("")
  telegramBotToken String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==================== AUTH ====================

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String   @default("Admin")
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== KNOWLEDGE BASE ====================

model Category {
  id          String           @id @default(uuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String           @default("")
  icon        String           @default("folder")
  color       String           @default("#4A7C9B")
  sortOrder   Int              @default(0)
  entries     KnowledgeEntry[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([businessId, id]) // §8.4 composite FK target — KnowledgeEntry.categoryId
  @@index([businessId])
}

model KnowledgeEntry {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String
  // §8.4 composite FK — a KnowledgeEntry can never reference another business's Category.
  category   Category @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Cascade)
  title      String
  content    String
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  version    Int      @default(1)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
  @@index([businessId])
}

// ==================== TEAM ====================

model Department {
  id          String       @id @default(uuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String       @default("")
  email       String       @default("")
  members     TeamMember[]
  tickets     Ticket[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([businessId, id]) // §8.4 composite FK target — TeamMember.departmentId, Ticket.departmentId
  @@index([businessId])
}

model TeamMember {
  id           String     @id @default(uuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String     @default("")
  role         String     @default("member")
  expertise    String     @default("")
  departmentId String
  // §8.4 composite FK — a TeamMember can never reference another business's Department.
  department   Department @relation(fields: [businessId, departmentId], references: [businessId, id], onDelete: Cascade)
  isAvailable  Boolean    @default(true)
  tickets      Ticket[]
  schedules    Schedule[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([businessId, id]) // §8.4 composite FK target — Ticket.assignedToId, Schedule.teamMemberId
  @@index([departmentId])
  @@index([businessId])
}

// ==================== CONVERSATIONS ====================

model Conversation {
  id              String            @id @default(uuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel         String
  customerName    String            @default("Unknown")
  customerContact String            @default("")
  customerId      String?
  // §8.4 composite FK — a Conversation can never reference another business's Customer.
  customer        Customer?         @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: SetNull)
  status          String            @default("active")
  satisfaction    Int?
  summary         String            @default("")
  metadata        Json              @default("{}")
  messages        Message[]
  tickets         Ticket[]
  tags            ConversationTag[]
  notes           InternalNote[]
  callLogs        CallLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([businessId, id]) // §8.4 composite FK target — Message/Ticket/InternalNote/ConversationTag/CallLog.conversationId
  @@index([channel])
  @@index([status])
  @@index([customerContact])
  @@index([channel, status])
  @@index([createdAt])
  @@index([customerId])
  @@index([businessId])
}

model Message {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String
  // §8.4 composite FK — a Message can never reference another business's Conversation.
  conversation   Conversation @relation(fields: [businessId, conversationId], references: [businessId, id], onDelete: Cascade)
  role           String
  content        String
  mediaType      String?
  mediaUrl       String?
  toolCalls      Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([businessId])
}

// ==================== TICKETS ====================

model Ticket {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // §8.4 composite FKs — a Ticket can never reference another business's
  // Conversation/Department/TeamMember (§8.4's own worked example).
  conversationId String?
  conversation   Conversation? @relation(fields: [businessId, conversationId], references: [businessId, id], onDelete: SetNull)
  departmentId   String?
  department     Department?   @relation(fields: [businessId, departmentId], references: [businessId, id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     TeamMember?   @relation(fields: [businessId, assignedToId], references: [businessId, id], onDelete: SetNull)
  title          String
  description    String
  status         String        @default("open")
  priority       String        @default("medium")
  resolution     String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([businessId])
}

// ==================== TAGS ====================

model Tag {
  id            String            @id @default(uuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  color         String            @default("#4A7C9B")
  conversations ConversationTag[]
  createdAt     DateTime          @default(now())

  // Global uniqueness -> tenant-scoped uniqueness (§12): two businesses may
  // each have their own "Urgent" tag.
  @@unique([businessId, name])
  @@unique([businessId, id]) // §8.4 composite FK target — ConversationTag.tagId
}

model ConversationTag {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String
  // §8.4 composite FKs — a ConversationTag can never reference another business's Conversation/Tag.
  conversation   Conversation @relation(fields: [businessId, conversationId], references: [businessId, id], onDelete: Cascade)
  tagId          String
  tag            Tag          @relation(fields: [businessId, tagId], references: [businessId, id], onDelete: Cascade)

  @@unique([conversationId, tagId])
  @@index([businessId])
}

// ==================== CALL LOGS ====================

model CallLog {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // §2.8 schema-quality fix, bundled with the Phase 1 composite-FK work
  // (§8.4 table, task 12): correlation was previously by phone/time only.
  conversationId String?
  conversation   Conversation? @relation(fields: [businessId, conversationId], references: [businessId, id], onDelete: SetNull)
  callSid        String        @unique
  from           String
  to             String
  duration       Int           @default(0)
  status         String        @default("initiated")
  recording      String?
  summary        String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessId])
  @@index([conversationId])
}

// ==================== CHANNELS ====================

model Channel {
  id        String   @id @default(uuid())
  type      String   @unique
  isActive  Boolean  @default(false)
  config    Json     @default("{}")
  status    String   @default("disconnected")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== SCHEDULES ====================

model Schedule {
  id           String     @id @default(uuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // §2.8 schema-quality fix, bundled with CallLog's above (task 12).
  teamMemberId String
  teamMember   TeamMember @relation(fields: [businessId, teamMemberId], references: [businessId, id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String

  @@index([teamMemberId])
  @@index([dayOfWeek])
  @@index([businessId])
}

// ==================== WEBHOOKS ====================

model Webhook {
  id          String            @id @default(uuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String            @default("")
  url         String
  method      String            @default("POST")
  headers     Json              @default("{}")
  isActive    Boolean           @default(true)
  triggerOn   String
  deliveries  WebhookDelivery[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([businessId, id]) // §8.4 composite FK target — WebhookDelivery.webhookId
  @@index([businessId])
}

model WebhookDelivery {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  webhookId   String
  // §8.4 composite FK — a WebhookDelivery can never reference another business's Webhook.
  webhook     Webhook   @relation(fields: [businessId, webhookId], references: [businessId, id], onDelete: Cascade)
  event       String
  payload     Json
  status      String    @default("pending") // pending, delivered, failed
  statusCode  Int?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([webhookId])
  @@index([status, nextRetryAt])
  @@index([businessId])
}

// ==================== ACTIVITY LOG ====================

model ActivityLog {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  action      String // conversation.created, ticket.assigned, settings.updated, etc.
  // Intentionally polymorphic (§2.8, §8.4) — must reference many different
  // model types by design, so it is explicitly excluded from the
  // composite-FK treatment applied elsewhere; protected by layers 1-2-4-5
  // only.
  entity      String // conversation, ticket, settings, knowledge, team
  entityId    String?
  description String
  userId      String?
  userName    String   @default("System")
  metadata    Json     @default("{}")
  requestId   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
  @@index([businessId])
}

// ==================== SLA RULES ====================

model SLARule {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  description       String   @default("")
  channel           String   @default("all") // all, whatsapp, email, phone
  priority          String   @default("all") // all, low, medium, high, urgent
  firstResponseMins Int      @default(30)
  resolutionMins    Int      @default(480)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([businessId])
}

// ==================== CANNED RESPONSES ====================

model CannedResponse {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  content    String
  category   String   @default("General")
  shortcut   String   @default("") // e.g., /greeting, /refund
  isActive   Boolean  @default(true)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

// ==================== CUSTOMERS ====================

model Customer {
  id            String         @id @default(uuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  email         String         @default("")
  phone         String         @default("")
  whatsapp      String         @default("")
  tags          String         @default("") // comma-separated
  isBlocked     Boolean        @default(false)
  notes         CustomerNote[]
  conversations Conversation[]
  metadata      Json           @default("{}")
  firstContact  DateTime       @default(now())
  lastContact   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([businessId, id]) // §8.4 composite FK target — Conversation.customerId, CustomerNote.customerId
  // Tenant-scoped lookup indexes (§12) — replace the old global-scoped ones,
  // since customer lookups always happen within one business.
  @@index([businessId, email])
  @@index([businessId, phone])
  @@index([businessId, whatsapp])
  @@index([lastContact])
}

model CustomerNote {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  // §8.4 composite FK — a CustomerNote can never reference another business's Customer.
  customer   Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)
  content    String
  authorName String   @default("Admin")
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([businessId])
}

// ==================== AUTOMATION RULES ====================

model AutomationRule {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  description  String   @default("")
  type         String // auto_route, auto_tag, auto_reply, keyword_alert
  isActive     Boolean  @default(true)
  conditions   Json     @default("[]") // [{field, operator, value}]
  actions      Json     @default("[]") // [{type, target, value}]
  priority     Int      @default(0)
  triggerCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
}

// ==================== BUSINESS HOURS ====================

model BusinessHours {
  id             String   @id @default("default")
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(false)
  timezone       String   @default("UTC")
  monday         String   @default("09:00-18:00") // empty = closed
  tuesday        String   @default("09:00-18:00")
  wednesday      String   @default("09:00-18:00")
  thursday       String   @default("09:00-18:00")
  friday         String   @default("09:00-18:00")
  saturday       String   @default("")
  sunday         String   @default("")
  offlineMessage String   @default("We are currently offline. We will get back to you during business hours.")

  // Singleton -> one row per business (§12): the pre-migration row keeps its
  // literal "default" id (backfilled in place, not duplicated — see
  // scripts/phase1-migration-steps.ts), so uniqueness is enforced on
  // businessId rather than by changing the id generation strategy.
  @@unique([businessId])
}

// ==================== API KEYS ====================

// §9.4 rewrite (task 11): keyPrefix+keyHash replace the plaintext `key` —
// a database compromise now discloses only hashes, never a reusable secret.
// Pre-existing keys (none in this installation) are invalidated rather than
// rehashed — see scripts/phase1-migration-steps.ts's invalidateExistingApiKeys
// and the Phase 1 kickoff report for why.
model ApiKey {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String // e.g. "zy_live_a1b2c3d4" — safe to display/search by, not secret
  keyHash    String // SHA-256 (or stronger) hash of the full secret — never the secret itself
  role       String    @default("agent") // capped below "owner" (§9.1) — enforced at creation time, not by the schema
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, id])
  @@index([keyPrefix])
}

// ==================== INTERNAL NOTES ====================

model InternalNote {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String
  // §8.4 composite FK — an InternalNote can never reference another business's Conversation.
  conversation   Conversation @relation(fields: [businessId, conversationId], references: [businessId, id], onDelete: Cascade)
  content        String
  authorName     String       @default("Admin")
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([businessId])
}

// ==================== CAMPAIGNS ====================

model Campaign {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  channel     String    @default("email")
  message     String
  subject     String    @default("")
  segments    Json      @default("[]")
  status      String    @default("draft") // draft, scheduled, running, completed, paused
  scheduledAt DateTime?
  sentCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
}

// ==================== FLOWS ====================

model Flow {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  description  String   @default("")
  startNodeId  String   @default("")
  nodes        Json     @default("[]")
  isActive     Boolean  @default(false)
  triggerCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
}
