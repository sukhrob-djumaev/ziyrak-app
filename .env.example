# ============================================
# Owly - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# Required variables are marked with [REQUIRED]
# ============================================

# [REQUIRED] PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/owly?schema=public"

# ---- Scaling (PLAN.md §28.4/§29/§46.8) — all optional, all off by default ----
# Redis shares the rate limit, cache and realtime bus across replicas. Unset =
# in-memory (correct for exactly one app replica; the local-dev default). Redis
# is never a source of truth: if it is down the app keeps working per-process.
# REDIS_URL="redis://localhost:6379"
# REDIS_KEY_PREFIX="owly:"
# Behind PgBouncer (transaction pooling): DATABASE_URL points at the pooler,
# DIRECT_DATABASE_URL straight at Postgres for migrations and the job queue
# (they need session-level advisory locks). DATABASE_POOL_MAX is this
# process's pool size: (postgres_max_connections / replica_count) minus
# headroom for the worker.
# DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/owly?schema=public"
# DATABASE_POOL_MAX="10"
# Proxies in front of the app that append to x-forwarded-for (rate limiting keys on
# the client address this yields). Unset = first entry, only safe if the edge
# proxy overwrites the header. See src/lib/client-ip.ts.
# TRUSTED_PROXY_HOPS="1"
# Log one line per processed job (for attributing jobs to a worker in a load test).
# JOB_TRACE="1"

# [REQUIRED] Secret key for JWT token signing (use a random 32+ char string)
JWT_SECRET="change-this-to-a-random-secret"

# [REQUIRED] App URL (used for callbacks and webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment (development | production)
NODE_ENV="development"

# ---- AI Provider ----
# OpenAI API key - required for AI-powered responses
OPENAI_API_KEY="sk-your-openai-api-key"

# ---- Phone Channel (Twilio + ElevenLabs) ----
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# ---- WhatsApp (Meta Cloud API) — PLAN.md §20.2/§46.7 ----
# Platform-level: webhook subscription verification only. Each connection
# stores phoneNumberId, accessToken, businessAccountId, and its own Meta App
# Secret encrypted per ChannelConnection; there is no platform-wide
# META_APP_SECRET (a connection without its own secret is rejected).
# META_WEBHOOK_VERIFY_TOKEN="change-this-to-a-random-secret"
# META_GRAPH_API_VERSION="v21.0"

# ---- Webhook Security ----
# Secret key for HMAC-SHA256 webhook payload signatures
WEBHOOK_SECRET="change-this-to-a-random-secret"

# ---- Secret Resolver (PLAN.md §10.3) ----
# [REQUIRED as of Phase 1] Envelope-encryption key for tenant channel/
# infrastructure secrets. Versioned so keys can rotate: add SECRET_KEY_V2 to
# rotate, never delete SECRET_KEY_V1 while any secret is still encrypted
# under it.
SECRET_KEY_V1="change-this-to-a-random-secret"

# ---- CORS (optional) ----
# Set to allow cross-origin API access (e.g., "https://your-frontend.com")
# CORS_ORIGIN=""

# ---- Optional ----
NEXTAUTH_SECRET="change-this-to-a-random-secret"

# ---- WhatsApp Web (dev/demo only) — PLAN.md §20.1/§46.7 ----
# Shows the QR-code whatsapp-web.js card in the Channels dashboard. Never
# enable for a production multi-tenant deployment; the adapter itself is
# additionally hard-gated to the default business.
# NEXT_PUBLIC_ENABLE_WHATSAPP_WEB="true"
