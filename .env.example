# ============================================
# Ziyrak - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values. .env is gitignored — never
# commit it, never paste its values into issues, logs or chat.
#
#   [REQUIRED]    the app will not start (or is insecure) without it
#   [RECOMMENDED] works without it, but you almost certainly want it
#   commented settings may be conditionally required; read the relevant section
#
# Secrets are deliberately EMPTY below: a forgotten one fails loudly instead of
# running with a guessable placeholder. Generate each one separately with:
#   openssl rand -hex 32
# ============================================

# ---- Core -----------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string.
# Set BOTH URLs explicitly to the intended database (DIRECT may bypass a pooler).
# Leave empty until a separate local target is provisioned. Tests write/delete data:
# use a disposable test DB, never a user/live/acceptance DB. Current harness safety
# gaps are tracked in PLAN L1.1; a database name alone is not proof it is disposable.
DATABASE_URL=
DIRECT_DATABASE_URL=

# [REQUIRED] Signs login tokens. Random, 32+ characters. The app refuses to start without it.
JWT_SECRET=

# P1 privileged enrollment/recovery: separate SHA-256 hex hashes of owner-held
# high-entropy proofs. Empty/malformed values keep the corresponding action closed.
# Never use either raw proof here or expose these settings to the browser.
PLATFORM_BOOTSTRAP_PROOF_SHA256=
PLATFORM_RECOVERY_PROOF_SHA256=

# [REQUIRED] Public URL of the app (callbacks, webhooks, widget). NEXT_PUBLIC_* values are
# baked into the build: rebuild after changing it, and set the real public HTTPS URL
# (not localhost) before serving real customers or Meta webhooks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Normally leave unset: `next dev`, `next start`, vitest and your process manager set it.
# NODE_ENV="production"

# Allow cross-origin API access (e.g. "https://your-frontend.com").
# CORS_ORIGIN=""

# ---- Secrets (PLAN.md §10.3) ------------------------------------------------

# [REQUIRED] Envelope-encryption key for tenant channel credentials and dedicated-database
# connection secrets. Back it up securely: losing a required key loses readable credentials.
# Known F09: current resolver requires contiguous versions beginning with V1. Do not
# retire V1 or assume sparse versions work until L1.3 repairs/tests rotation and recovery.
SECRET_KEY_V1=

# [RECOMMENDED] HMAC-SHA256 key for signing outgoing webhook payloads (X-Ziyrak-Signature; X-Owly-Signature is also sent for pre-rename receivers).
# If empty, outgoing webhooks are sent UNSIGNED and receivers cannot verify them.
WEBHOOK_SECRET=

# ---- AI providers -------------------------------------------------------------
# New managed workspaces use encrypted provider policy/credentials configured through
# the secured PLATFORM AI console; customers do not enter AI keys. Legacy BYOK is
# compatibility only. Keys below are for live smoke/acceptance/load tooling, not runtime
# managed configuration. Never run the old load script unchanged (review F08).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Used by the acceptance and load-test scripts to point at an OpenAI-compatible stand-in.
# Leave unset in real use.
# OPENAI_BASE_URL=

# ---- Platform account mail (verification, reset and invitations) ----------------
# Production: select smtp and configure the approved sender. Empty/unconfigured
# transport fails delivery. This is separate from tenant customer-support Email.
# MAIL_TRANSPORT="smtp"
# PLATFORM_SMTP_HOST=
# PLATFORM_SMTP_PORT="587"
# PLATFORM_SMTP_FROM=
# PLATFORM_SMTP_USER=
# PLATFORM_SMTP_PASSWORD=
# Isolated local tests/acceptance ONLY (contains sensitive one-time links):
# MAIL_TRANSPORT="capture"
# MAIL_CAPTURE_FILE="/absolute/private/test-directory/mail.jsonl"

# ---- WhatsApp (Meta Cloud API) — PLAN.md §20.2/§46.7 ----------------------------
# Platform-level: webhook subscription verification only. Each connection stores its
# phoneNumberId, accessToken, businessAccountId and its OWN Meta App Secret encrypted;
# there is no platform-wide App Secret (a connection without its own is rejected).
# [REQUIRED for WhatsApp] any random string; enter the same value in Meta's webhook setup.
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_API_VERSION=  # explicitly verify current provider-supported version before release

# WhatsApp Web QR card (dev/demo only). Never enable on a production multi-tenant
# deployment; the adapter is additionally hard-gated to the default business.
# NEXT_PUBLIC_ENABLE_WHATSAPP_WEB="true"

# ---- Scaling (PLAN.md §28.4/§29/§46.8) — optional, off by default ----------------
# Redis shares the rate limit, cache and realtime bus across replicas. Unset = in-memory
# for one app replica; web/worker realtime still needs acceptance. Redis is not the
# source of truth. Rehearse outage/fallback: per-process behavior is not proof of shared
# guarantees across replicas. Keep Redis private and authenticated.
# REDIS_URL="redis://:password@localhost:6379"
# REDIS_KEY_PREFIX="owly:"
# Behind PgBouncer (transaction pooling): DATABASE_URL points at the pooler and
# DIRECT_DATABASE_URL straight at Postgres for migrations and the job queue (they need
# session-level advisory locks). DATABASE_POOL_MAX is this process's pool size:
# (postgres_max_connections / replica_count) minus headroom for the worker.
# DATABASE_POOL_MAX="10"
# Proxies in front of the app that append to x-forwarded-for (rate limiting keys on the
# client address this yields). Unset = first entry, only safe if the edge proxy overwrites
# the header. Set to 1 behind a single tunnel/load balancer. See src/lib/client-ip.ts.
# TRUSTED_PROXY_HOPS="1"
# Log one line per processed job (to attribute jobs to a worker in a load test).
# JOB_TRACE="1"

# ---- Tests and live smoke suites (never needed to run the app) -------------------------
# Real Redis for the Redis adapter contract tests (CI sets this).
# REDIS_TEST_URL="redis://localhost:6379"
# `npm run test:smoke:meta` runs only when these four are set (otherwise it skips):
# META_TEST_PHONE_NUMBER_ID=
# META_TEST_ACCESS_TOKEN=
# META_TEST_RECIPIENT=          (digits only, no +)
# META_TEST_APP_SECRET=         (falls back to META_APP_SECRET; the app itself never reads either)
# META_TEST_BUSINESS_ACCOUNT_ID=   (optional)

# ---- Phase 9 operator CLI (`npm run infra`) — do NOT put these in .env ---------------
# They hold database credentials. Pass them inline for the single command that needs them:
#   DEDICATED_DATABASE_URL=… npm run infra -- provision <profileId>
#   DEDICATED_ADMIN_DATABASE_URL=… npm run infra -- enable-rls <businessId> <profileId>

# ---- Legacy / not read by the application code ---------------------------------------
# Kept only because the Helm secret template and older docs still mention them. Channel
# credentials (Twilio, etc.) are entered per business in the dashboard and stored
# encrypted; none of these need to be set. Safe to omit.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# ELEVENLABS_API_KEY=
# NEXTAUTH_SECRET=
